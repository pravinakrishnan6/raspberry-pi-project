import time
import network
from machine import Pin
from umqtt.simple import MQTTClient

WIFI_SSID = "Wokwi-GUEST"
WIFI_PASS = ""
BROKER_IP = "broker.hivemq.com"
CLIENT_ID = "pravina_esp_node_01"

# 3 Condition Topics
TOPIC_RED  = b"pravina_group/red/set"
TOPIC_BLUE = b"pravina_group/blue/set"
TOPIC_BOTH = b"pravina_group/both/set"

# Relay outputs (D5 = Red, D18 = Blue)
red_light = Pin(5, Pin.OUT)
blue_light = Pin(18, Pin.OUT)

red_light.value(0)
blue_light.value(0)

def connect_wifi():
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    wlan.connect(WIFI_SSID, WIFI_PASS)
    while not wlan.isconnected():
        time.sleep(0.5)
    print("Wi-Fi connected!")

def sub_cb(topic, msg):
    cmd = msg.decode().strip().upper()
    print("Topic:", topic, "| Command:", cmd)

    # CONDITION 1: Red Light Only
    if topic == TOPIC_RED:
        if cmd == "ON":
            red_light.value(1)
        elif cmd == "OFF":
            red_light.value(0)

    # CONDITION 2: Blue Light Only
    elif topic == TOPIC_BLUE:
        if cmd == "ON":
            blue_light.value(1)
        elif cmd == "OFF":
            blue_light.value(0)

    # CONDITION 3: Both Red and Blue Together
    elif topic == TOPIC_BOTH:
        if cmd == "ON":
            red_light.value(1)
            blue_light.value(1)
        elif cmd == "OFF":
            red_light.value(0)
            blue_light.value(0)

connect_wifi()
client = MQTTClient(CLIENT_ID, BROKER_IP)
client.set_callback(sub_cb)
client.connect()

# Subscribe to all 3 condition topics
client.subscribe(TOPIC_RED)
client.subscribe(TOPIC_BLUE)
client.subscribe(TOPIC_BOTH)

print("Ready! Listening for Red, Blue, and Both commands...")

while True:
    client.check_msg()
    time.sleep(0.1)
